# mobile/.env.example
# Copy this file to .env and fill in the values before running `npx expo start`.
#
#   cp .env.example .env
#
# NEVER commit .env -- it is gitignored.
#
# IMPORTANT: Expo bundles EXPO_PUBLIC_* variables at BUILD TIME (when Metro
# processes the bundle), NOT at runtime. If you change .env while
# `npx expo start` is already running, you must restart the dev server:
#
#   npx expo start --clear
#
# ─── Backend API (Required) ──────────────────────────────────────────────────
# No trailing slash.
#
# Dev (local docker compose):   http://localhost:3000/api/v1
# Dev (physical device on LAN): http://<your-local-IP>:3000/api/v1
# PR Preview:                   https://pr-<NUMBER>-api.irtaki.example.com/api/v1
#                               (once Coolify is wired -- see docs/pr-preview.md)
# Production:                   https://api.irtaki.example.com/api/v1
#                               (EPIC-12, deferred -- see docs/pr-preview.md)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# ─── Native Firebase app registration (Android/iOS builds only) ──────────────
# Set identifiers to the EXACT values registered in your Firebase project.
# These build-time settings are not Firebase service-account credentials.
# Leave unset for web-only development. Native builds validate them before compiling.
ANDROID_APPLICATION_ID=
IOS_BUNDLE_IDENTIFIER=
# Paths relative to mobile/ (or absolute paths on the build machine).
# Download these per-app config files from Firebase Project settings → Your apps.
FIREBASE_ANDROID_CONFIG=
FIREBASE_IOS_CONFIG=
# development for local debug signing; production for distribution signing.
IOS_APNS_ENVIRONMENT=development
# Optional local Android release signing settings. Defaults use your home directory's
# Documents/irtaki-upload.jks and the alias irtaki-upload.
ANDROID_UPLOAD_KEYSTORE=
ANDROID_UPLOAD_KEY_ALIAS=
# Required: set the existing keystore password in your ignored local .env.
# Quote the value; escape any dollar signs as \$ (Expo expands environment variables).
ANDROID_UPLOAD_STORE_PASSWORD=
# Leave blank when the key password matches the keystore password.
ANDROID_UPLOAD_KEY_PASSWORD=
# CI may supply these as private environment secrets. Never use EXPO_PUBLIC_*.
# Never put the backend Firebase private key in this file or EXPO_PUBLIC_*.
# Native push uses FCM directly; no Expo/EAS project or token is required.
