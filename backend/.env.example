# backend/.env.example
# Copy this file to .env and fill in the values before starting the server.
#
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored.
# For docker compose: DB_HOST is overridden to "postgres" by the compose file;
#   leave it as "localhost" here for bare `npm run start:dev` usage.

# ─── Database (Required) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
# DB_NAME has no default and the API refuses to boot without it (ISS #145) —
# a wrong credential fails to connect, a wrong database name connects fine and
# writes to the wrong place.
#
# `irtaki` below is the DEVELOPMENT database (it matches docker-compose.yml's
# POSTGRES_DB). The integration suite must never be pointed at it: its teardown
# helpers empty whole tables — `notification_log` and `audit_entries` are
# deleted wholesale — and doing that to a working database is exactly the
# accident #145 records. Export DB_NAME for a dedicated database when running
# the suite (e.g. DB_NAME=irtaki_test, created/migrated/seeded on its own — see
# "Integration tests" in README.md); the purge helpers refuse to run against
# `irtaki` regardless.
DB_NAME=irtaki
DB_USER=irtaki
DB_PASS=irtaki

# ─── Server & Environment (Required) ─────────────────────────────────────────
PORT=3000
# NODE_ENV: development | test | production
NODE_ENV=development
# LOG_LEVEL: trace | debug | info | warn | error | fatal (pino)
LOG_LEVEL=info
CENTER_TIMEZONE=Africa/Tunis

# ─── Auth Secrets (Required — use min 32 random characters in production) ─────
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-key
JWT_REFRESH_PEPPER=dev-jwt-refresh-pepper-minimum-32-chars-key

# ─── Rate limiting (Optional; APIS §9.8 / NFR-22) ─────────────────────────────
# Requests allowed per 60-second window before the API answers 429
# RATE_LIMITED. Defaults live in src/config/rate-limit.config.ts; SAS §3201
# records the numeric NFR target as undefined, so these are tunable per
# environment rather than a documented business rule.
#   /auth/*             — per client IP (credential stuffing)
#   POST /join-requests — per authenticated user (ISS-19 queue flooding)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_JOIN_REQUESTS_PER_MINUTE=5

# ─── Email — Mailgun (Optional in dev; Required in production) ────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ─── Push Notifications — Expo / FCM (Optional in dev; Required in production) ──
# Set to the full JSON content of the Firebase service account credentials file.
FCM_SERVICE_ACCOUNT_JSON=

# ─── Observability — Healthchecks.io (Optional in dev; Required in production) ──
# Dead-man's-switch (ADR-033, TS §31/§32): one ping URL per scheduled job,
# HEALTHCHECKS_PING_URL_<JOB>. The job POSTs it after every successful run;
# a missed ping alerts. In development/test an empty value only disables the
# ping (a WARN is logged once); in production the API refuses to boot without it.
# WeeklyReportFinalizationJob — DS-02, ticks every 15 minutes (ADR-030).
HEALTHCHECKS_PING_URL_WEEKLY_REPORT_FINALIZATION=
# DailyReminderEvaluationJob — N-01 at student-local 20:00 and N-02 at the
# student-local start of the recitation day, on the same 15-minute tick.
HEALTHCHECKS_PING_URL_DAILY_REMINDER_EVALUATION=
# AtRiskEvaluationJob — N-07, daily.
HEALTHCHECKS_PING_URL_AT_RISK_EVALUATION=
# PaymentDueSoonEvaluationJob — N-06, daily.
HEALTHCHECKS_PING_URL_PAYMENT_DUE_SOON_EVALUATION=
# CoverageReconciliationJob — ADR-029, nightly and global.
HEALTHCHECKS_PING_URL_COVERAGE_RECONCILIATION=
