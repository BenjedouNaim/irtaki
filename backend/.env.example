# backend/.env.example
# Copy this file to .env and fill in the values before starting the server.
#
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored.
# For docker compose: DB_HOST is overridden to "postgres" by the compose file;
#   leave it as "localhost" here for bare `npm run start:dev` usage.

# ─── Database (Required) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=irtaki
DB_USER=irtaki
DB_PASS=irtaki

# ─── Server & Environment (Required) ─────────────────────────────────────────
PORT=3000
# NODE_ENV: development | test | production
NODE_ENV=development
# LOG_LEVEL: trace | debug | info | warn | error | fatal (pino)
LOG_LEVEL=info
CENTER_TIMEZONE=Africa/Tunis

# ─── Auth Secrets (Required — use min 32 random characters in production) ─────
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-key
JWT_REFRESH_PEPPER=dev-jwt-refresh-pepper-minimum-32-chars-key

# ─── Email — Mailgun (Optional in dev; Required in production) ────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ─── Push Notifications — Expo / FCM (Optional in dev; Required in production) ──
# Set to the full JSON content of the Firebase service account credentials file.
FCM_SERVICE_ACCOUNT_JSON=

# ─── Observability — Healthchecks.io (Optional in dev; Required in production) ──
# Dead-man's-switch (ADR-033, TS §31/§32): one ping URL per scheduled job,
# HEALTHCHECKS_PING_URL_<JOB>. The job POSTs it after every successful run;
# a missed ping alerts. Leave empty to disable the ping (a WARN is logged once).
# WeeklyReportFinalizationJob — DS-02, ticks every 15 minutes (ADR-030).
HEALTHCHECKS_PING_URL_WEEKLY_REPORT_FINALIZATION=
