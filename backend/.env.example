# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=irtaki
DB_USER=irtaki
DB_PASS=irtaki
# Or full DATABASE_URL=postgresql://irtaki:irtaki@localhost:5432/irtaki

# Server & Environment
PORT=3000
NODE_ENV=development

# Auth Secrets (min 32 characters in production)
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-key
JWT_REFRESH_PEPPER=dev-jwt-refresh-pepper-minimum-32-chars-key

# Email (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Push Notifications (Expo / FCM)
FCM_SERVICE_ACCOUNT_JSON=
