{
  "name": "irtaki-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Appium end-to-end suite for the Irtaki mobile app",
  "type": "module",
  "scripts": {
    "test:ios": "wdio run ./wdio.ios.conf.ts",
    "test:android": "wdio run ./wdio.android.conf.ts",
    "smoke:ios": "wdio run ./wdio.ios.conf.ts --mochaOpts.grep @P0",
    "smoke:android": "wdio run ./wdio.android.conf.ts --mochaOpts.grep @P0",
    "db:reset": "tsx ./scripts/reset-db.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@wdio/appium-service": "^9.31.9",
    "@wdio/cli": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "webdriverio": "^9.31.9"
  }
}
